# HTTP
PORT=3000
HOST=127.0.0.1
LOG_REQUESTS=true

# Storage
DB_PATH=data/labflow.db
UPLOAD_DIR=data/uploads

# Session and security
SESSION_IDLE_MINUTES=30
COOKIE_SECURE=false
# Set to the reverse-proxy address count when running behind nginx/Caddy.
TRUST_PROXY=false

# Booking rules
UTC_OFFSET_MINUTES=480
LAB_OPEN_TIME=08:00
LAB_CLOSE_TIME=22:00
MIN_BOOKING_MINUTES=30
MAX_BOOKING_HOURS=4
CANCEL_CUTOFF_MINUTES=30

# Request body limit for JSON photo uploads
MAX_BODY_MB=10
